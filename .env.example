# Copié en .env par make install. Valeurs de développement local seulement.

# Postgres de Docker Compose
POSTGRES_PORT=5433
DATABASE_URL=postgresql://sandbox:sandbox@localhost:5433/sandbox

# API ; l'interface (facturation-web) l'appelle directement depuis le navigateur (CORS limité à APP_URL)
PORT=4010
APP_URL=http://localhost:3010
